# Copy to deploy/.env and fill in the three values. The file is ignored by git.

# The database password, shared by the two services.
POSTGRES_PASSWORD=

# The first administrator, email and token, read on the first start only.
# The token is what the CLI carries as PLANAFFE_TOKEN; at least 32 characters.
PLANAFFE_BOOTSTRAP_ADMIN=
PLANAFFE_BOOTSTRAP_EMAIL=
PLANAFFE_BOOTSTRAP_TOKEN=

# Optional. Defaults shown.
# PLANAFFE_CLAIM_EXPIRY_HOURS=4
# PLANAFFE_DELETION_GRACE_DAYS=7
# PLANAFFE_LOG_ENDPOINT=https://logs.example.org
# PLANAFFE_LOG_TOKEN=
# PLANAFFE_LOG_LEVEL=Information

# What this instance answers as, and the whole of the TLS decision. Unset it is
# `:80` — plain HTTP for whatever host asked, which is the trial on a laptop and
# nothing more. Name a domain and Caddy obtains a certificate for it and
# redirects port 80; set PLANAFFE_PUBLIC_URL to the same address.
# PLANAFFE_SITE_ADDRESS=plan.example.org

# The published ports, 80 and 443 unless they are set. Leave them alone on a
# machine that is reachable from the internet: the certificate is fetched over
# those two ports, and a domain behind a moved one does not get one. The value
# is the whole left half of a published port, so an address in front of it binds
# there and nowhere else.
# PLANAFFE_HTTP_PORT=8080
# PLANAFFE_HTTPS_PORT=8443
# PLANAFFE_HTTP_PORT=127.0.0.1:8080

# The image this instance runs. `:latest` is the newest stable release and
# never a prerelease; `:main` follows the trunk; a `sha-<commit>` or a version
# pins the installation to one build, which is the way off a release or a trunk
# that turned out bad without waiting for the next one.
# PLANAFFE_IMAGE=ghcr.io/datavisionzero/planaffe:latest

# The reverse proxy in front of the instance, so that the caller's address and
# scheme are the caller's rather than the proxy's. An address, a CIDR network,
# or `all` where the proxy is the only thing that can reach the instance —
# which is the case in this Compose file, and why `all` is the default here.
# PLANAFFE_TRUSTED_PROXY=all

# Transactional email. Leave all of these unset to disable it.
# PLANAFFE_PUBLIC_URL=https://plan.example.org
# PLANAFFE_SMTP_HOST=smtp.example.org
# PLANAFFE_SMTP_PORT=587
# PLANAFFE_SMTP_USERNAME=
# PLANAFFE_SMTP_PASSWORD=
# PLANAFFE_SMTP_SECURITY=starttls
# PLANAFFE_SMTP_FROM_ADDRESS=no-reply@example.org
# PLANAFFE_SMTP_FROM_NAME=planaffe
