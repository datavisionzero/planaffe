# What stands in front of the instance, and the whole of the TLS decision.
#
# The site address is one variable (`PLANAFFE_SITE_ADDRESS` in deploy/.env): a
# domain makes Caddy obtain and renew a certificate for it on its own and
# redirect port 80 to it, and the default `:80` is plain HTTP for a trial on
# loopback. There is no third case and no certificate to install by hand —
# that is why Caddy is here rather than a proxy that would need one.
#
# It is not a convenience. The browser session hangs on a cookie with the
# `__Host-` prefix and `Secure`, which works over HTTPS and nowhere else, and
# an invitation is a link that an email carries through the open network with
# somebody's password at the end of it. Both of those want TLS, and neither of
# them got it out of a Compose file that published 8080 in the clear.

{$PLANAFFE_SITE_ADDRESS} {
	# The instance speaks plain HTTP and only on the compose network; it
	# publishes no port of its own. This is the one hop that is not encrypted,
	# and it does not leave the host.
	reverse_proxy planaffe:8080

	# Caddy sets no request or response deadline unless it is told to, which is
	# exactly what the three waiting commands need: `pa next --claim --wait`,
	# `pa issue ask --wait` and `pa needs-you --wait` hold one request open for
	# as long as an hour (docs/operations.md). A proxy that timed those out
	# would turn Waiting into a poll without anybody noticing, so nothing here
	# sets a timeout.

	# The API answers JSON and the application is a handful of static files;
	# both compress well.
	encode zstd gzip

	# What the browser is told about this origin, on every answer. The policy
	# is what the built application needs and nothing more: its scripts,
	# styles and fonts come from here; images are data: URIs at most — the
	# favicon is one, and Markdown never loads an image; the only fetches go to
	# this instance. Styles allow `'unsafe-inline'` because the theme switch
	# and the editor put `<style>` elements into the page — scripts do not, and
	# the built index.html has no inline script. `blob:` workers are the
	# confetti's, drawn off the main thread.
	#
	# Nothing may frame it, `/device` least of all: a page that could put the
	# confirmation of a terminal's sign-in under somebody's cursor is the one
	# clickjacking that would matter here. HSTS only counts over HTTPS, so on a
	# trial at `:80` the browser ignores it, as it should.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
}
