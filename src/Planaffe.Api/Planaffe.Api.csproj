<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>planaffe-api</UserSecretsId>
    <!-- The operational verbs the CLI deliberately does not have — migrations,
         backups, the first account — run as `docker compose exec planaffe
         planaffe …`, so the binary is named for the line it appears in
         (docs/codebase.md). -->
    <AssemblyName>planaffe</AssemblyName>
    <RootNamespace>Planaffe.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Planaffe.Application/Planaffe.Application.csproj" />
    <ProjectReference Include="../Planaffe.Infrastructure/Planaffe.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Logaffe.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- The settings of a development run carry a known bootstrap token and
         the development database's password. They only apply under
         `ASPNETCORE_ENVIRONMENT=Development`, and they still have no business
         in an image somebody else runs. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
